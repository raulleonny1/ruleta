# Formato: una variable por línea, SIN comillas, SIN espacios alrededor del =
#
# Uso local: copia este archivo a ".env.local" y rellena los valores.
# Uso Vercel: Project → Settings → Environment Variables → "Import" / pegar líneas.
# También puedes usar el archivo ENV-PARA-VERCEL.txt (git ignorado) con valores ya puestos.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
